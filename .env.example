# Local: no DATABASE_URL = JSON files in backend/data (development only).
# Production Botkeep: set these via the Botkeep Environment panel. DO NOT upload a real .env file.
NODE_ENV=production
# Optional: exact final HTTPS domain, prevents cross-site writes and helps reverse proxies.
# PUBLIC_ORIGIN=https://your-subdomain.botkeep.cloud
HOST=0.0.0.0
# SERVER_PORT is supplied by Botkeep Network. Do not hardcode unless assigned.
# SERVER_PORT=3000
# Replace all placeholder values in Botkeep secrets before starting.
DATABASE_URL=postgresql://USERNAME:PASSWORD@DATABASE_HOST:5432/DATABASE_NAME
PGSSL_MODE=verify-full
# Add if Botkeep gives you a custom CA certificate. Encode line breaks as literal \n.
# PGSSL_CA_PEM=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
SEED_DEMO_DATA=false
APP_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
